# ============================================================
#  .gitignore — 厦门在招岗位爬取与匹配筛选系统
# ============================================================

# ---- Python 运行时产物 ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 运行时数据与导出文件（不入库）----
# 说明：data/ 与 output/ 无需提交，config.py 启动时会自动创建这两个目录。
#       库内数据抓取自厦门大学就业信息网，属第三方站点数据，
#       不适合放进公开仓库；导出文件是运行时产物，每次运行都会重新生成。
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
output/*
!output/.gitkeep

# ---- 爬虫自测产物 ----
# 直接运行 spiders/xmu_career.py（或 run.bat spider）会在项目根目录留下这个文件。
_spider_out.txt

# ---- 方案文件 ----
# --save-search / --save-filter 默认写到当前目录，属个人使用产物。
# 想保留某个方案并提交，用 `git add -f 文件名` 显式加回。
xiamen*.json
filter*.json
focus*.json
search*.json

# ---- 内部技术文档（本机保留，不公开）----
# 记录站点接口细节与排查过程，属个人工作笔记，不入公开仓库。
# 如需公开某篇，用 `git add -f 文件名` 显式加回。
抓取策略修复说明_*.md

# ---- 本地配置与凭据（本机专属，绝不提交）----
# local.bat：记录本机 Python 解释器路径，供 run.bat 使用。
#            模板见 local.bat.example。
local.bat
.env
.env.*
*.local.json
*.log
logs/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini
